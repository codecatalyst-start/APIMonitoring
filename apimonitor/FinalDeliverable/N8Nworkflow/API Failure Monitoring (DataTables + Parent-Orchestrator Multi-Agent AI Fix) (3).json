    {
      "parameters": {
        "jsCode": "const d = $json;\n\nconst badgeColor = {\n    LOW:\"#28a745\",\n    MEDIUM:\"#ff9800\",\n    HIGH:\"#f44336\",\n    CRITICAL:\"#8b0000\"\n}[d.severity] || \"#1976d2\";\n\nconst html = `\n<html>\n\n<body style=\"font-family:Arial;background:#f4f4f4;padding:20px;\">\n\n<div style=\"background:white;border-radius:10px;padding:20px;\">\n\n<h2 style=\"color:#d32f2f;\">\n🚨 API Failure Analysis\n</h2>\n\n<table style=\"border-collapse:collapse;width:100%;\">\n\n<tr>\n<td><b>Service</b></td>\n<td>${d.service_name}</td>\n</tr>\n\n<tr>\n<td><b>Endpoint</b></td>\n<td>${d.http_method} ${d.endpoint}</td>\n</tr>\n\n<tr>\n<td><b>Status</b></td>\n<td>${d.status_code}</td>\n</tr>\n\n<tr>\n<td><b>Severity</b></td>\n<td>\n<span style=\"\nbackground:${badgeColor};\ncolor:white;\npadding:5px 12px;\nborder-radius:8px;\">\n${d.severity}\n</span>\n</td>\n</tr>\n\n<tr>\n<td><b>Category</b></td>\n<td>${d.category}</td>\n</tr>\n\n<tr>\n<td><b>Occurred</b></td>\n<td>${d.created_at}</td>\n</tr>\n\n</table>\n\n<hr>\n\n<h3>Root Cause</h3>\n\n<p>${d.ai_root_cause}</p>\n\n<h3>Recommended Fix</h3>\n\n<p>${d.ai_fix_recommendation}</p>\n\n<h3>Sample Code</h3>\n\n<pre style=\"\nbackground:#272822;\ncolor:#f8f8f2;\npadding:15px;\noverflow:auto;\">\n${d.ai_code_example}\n</pre>\n\n<hr>\n\n<b>AI Confidence :</b> ${d.ai_confidence}%<br>\n\n<b>Analyzed At :</b> ${d.analyzed_at}\n\n</div>\n\n</body>\n</html>\n`;\n\nreturn [{\njson:{\n...d,\nemail_html:html\n}\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
