    {
      "parameters": {
        "jsCode": "// 1. Raw Orchestrator Agent output (should be the QA Reviewer tool's final JSON, passed through verbatim)\nconst rawOutput = ($json.output || $json.text || $json.response || '').toString().trim();\nconst cleaned = rawOutput.replace(/^```json\\s*/i, '').replace(/^```\\s*/i, '').replace(/```\\s*$/,'').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Orchestrator Agent did not return valid JSON: ' + cleaned);\n}\n\n// 2. Exact input fields that were given to the \"Insert Row (DataTable)\" node\nconst insertInput = $('Normalize Data').first().json;\n\n// 3. The row actually written by \"Insert Row (DataTable)\" (carries the generated id)\nconst insertedRow = $('Insert Row (DataTable)').first().json;\n\n// 4. Merge: insert-row input fields + inserted row (for id/columns) + final orchestrated AI response\nconst merged = {\n  ...insertInput,\n  ...insertedRow,\n  ai_status: 'COMPLETED',\n  ai_root_cause: parsed.rootCause,\n  ai_fix_recommendation: parsed.fixRecommendation,\n  ai_code_example: parsed.codeExample,\n  ai_confidence: parsed.confidence,\n  severity: parsed.severity || insertInput.severity,\n  category: parsed.category || insertInput.category,\n  review_notes: parsed.reviewNotes || '',\n  analyzed_at: new Date().toISOString()\n};\n\nreturn [{ json: merged }];"
      },
